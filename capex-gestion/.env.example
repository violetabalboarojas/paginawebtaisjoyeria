# Copie como .env y complete. Nunca suba el .env al repositorio.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=gestion.capex.pe
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestion.capex.pe
DATABASE_URL=postgres://capex:CLAVE@localhost:5432/capex_gestion
MEDIA_ROOT=/var/lib/capex/documentos
SESSION_TIMEOUT_SECONDS=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
DOCUMENT_MAX_MB=15
# Correo para "Recuperar contraseña"
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-responder@capex.pe
# Primer administrador (solo para el comando inicializar)
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
